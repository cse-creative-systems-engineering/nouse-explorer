{
  "name": "nouse-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron:start": "npm run build && npm run electron:build && electron dist-electron/electron/main.js",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron dist-electron/electron/main.js\"",
    "preloadRename": "true"
  },
  "dependencies": {
    "@nanostores/react": "^0.8.4",
    "nanostores": "^0.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "electron": "^44.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^9.1.0"
  },
  "main": "dist-electron/electron/main.js"
}
